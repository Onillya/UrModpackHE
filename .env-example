RENAME THAT FILE .env AND DELETE THIS LINE !!!

# Path to modpack's mods folder (Use / instead of \ to avoid errors)
MODS_DIR='C:/Users/%user%/curseforge/minecraft/Instances/%Modpack%/mods'

# Minecraft version
MC_VERSION=1.20.1

# Source language to translate from
SOURCE_LANG=en_us

# Output pack name
OUTPUT_ZIP=Modpack_Hebrew_Pack.zip